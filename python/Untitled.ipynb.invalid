   "source": [
    "# ==============================================================================\n",
    "# Encabezado: Extracción de la Tabla de Punto de Operación (.OP)\n",
    "# Descripción: Busca los puntos de operación correspondientes a VSG_TARGET y VGS_TARGET,\n",
    "#              calcula métricas (Id, gm, ro, gm*ro, gm/Id, Vth, Vov, Vdsat, fT) y\n",
    "#              presenta un DataFrame formateado de pandas para Mplvt, Mp, Mnlvt y Mn.\n",
    "# ==============================================================================\n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "# Definición de cortes 1D para PMOS (0:181) y NMOS (::181)\n",
    "p_slice = slice(0, 181)\n",
    "n_slice = slice(0, None, 181)\n",
    "\n",
    "# Vectores de barrido Vsg y Vgs\n",
    "vgs_p_sweep = np.real(abs(raw_data['v(@m.xmp.msky130_fd_pr__pfet_01v8[vgs])'][p_slice]))\n",
    "vgs_n_sweep = np.real(abs(raw_data['v(@m.xmn.msky130_fd_pr__nfet_01v8[vgs])'][n_slice]))\n",
    "\n",
    "# Índices para el punto de operación deseado\n",
    "idx_p = int(np.argmin(np.abs(vgs_p_sweep - VSG_TARGET)))\n",
    "idx_n = int(np.argmin(np.abs(vgs_n_sweep - VGS_TARGET)))\n",
    "\n",
    "# Mapeo de transistores y sus claves en el archivo RAW\n",
    "transistores = {\n",
    "    'Mplvt': {'tipo': 'PMOS', 'slice': p_slice, 'idx': idx_p, 'gm': '@m.xmplvt.msky130_fd_pr__pfet_01v8_lvt[gm]', 'gds': '@m.xmplvt.msky130_fd_pr__pfet_01v8_lvt[gds]', 'id': 'i(@m.xmplvt.msky130_fd_pr__pfet_01v8_lvt[id])', 'vth': 'v(@m.xmplvt.msky130_fd_pr__pfet_01v8_lvt[vth])', 'vdsat': 'v(@m.xmplvt.msky130_fd_pr__pfet_01v8_lvt[vdsat])', 'cgg': '@m.xmplvt.msky130_fd_pr__pfet_01v8_lvt[cgg]', 'vgs': 'v(@m.xmplvt.msky130_fd_pr__pfet_01v8_lvt[vgs])'},\n",
    "    'Mp':    {'tipo': 'PMOS', 'slice': p_slice, 'idx': idx_p, 'gm': '@m.xmp.msky130_fd_pr__pfet_01v8[gm]',        'gds': '@m.xmp.msky130_fd_pr__pfet_01v8[gds]',        'id': 'i(@m.xmp.msky130_fd_pr__pfet_01v8[id])',        'vth': 'v(@m.xmp.msky130_fd_pr__pfet_01v8[vth])',        'vdsat': 'v(@m.xmp.msky130_fd_pr__pfet_01v8[vdsat])',        'cgg': '@m.xmp.msky130_fd_pr__pfet_01v8[cgg]',        'vgs': 'v(@m.xmp.msky130_fd_pr__pfet_01v8[vgs])'},\n",
    "    'Mnlvt': {'tipo': 'NMOS', 'slice': n_slice, 'idx': idx_n, 'gm': '@m.xmnlvt.msky130_fd_pr__nfet_01v8_lvt[gm]', 'gds': '@m.xmnlvt.msky130_fd_pr__nfet_01v8_lvt[gds]', 'id': 'i(@m.xmnlvt.msky130_fd_pr__nfet_01v8_lvt[id])', 'vth': 'v(@m.xmnlvt.msky130_fd_pr__nfet_01v8_lvt[vth])', 'vdsat': 'v(@m.xmnlvt.msky130_fd_pr__nfet_01v8_lvt[vdsat])', 'cgg': '@m.xmnlvt.msky130_fd_pr__nfet_01v8_lvt[cgg]', 'vgs': 'v(@m.xmnlvt.msky130_fd_pr__nfet_01v8_lvt[vgs])'},\n",
    "    'Mn':    {'tipo': 'NMOS', 'slice': n_slice, 'idx': idx_n, 'gm': '@m.xmn.msky130_fd_pr__nfet_01v8[gm]',        'gds': '@m.xmn.msky130_fd_pr__nfet_01v8[gds]',        'id': 'i(@m.xmn.msky130_fd_pr__nfet_01v8[id])',        'vth': 'v(@m.xmn.msky130_fd_pr__nfet_01v8[vth])',        'vdsat': 'v(@m.xmn.msky130_fd_pr__nfet_01v8[vdsat])',        'cgg': '@m.xmn.msky130_fd_pr__nfet_01v8[cgg]',        'vgs': 'v(@m.xmn.msky130_fd_pr__nfet_01v8[vgs])'}\n",
    "}\n",
    "\n",
    "# Construcción de la tabla .OP\n",
    "tabla_op = []\n",
    "for nombre, info in transistores.items():\n",
    "    s = info['slice']\n",
    "    idx = info['idx']\n",
    "    \n",
    "    gm = float(np.real(abs(raw_data[info['gm']][s][idx])))\n",
    "    gds = float(np.real(abs(raw_data[info['gds']][s][idx])))\n",
    "    id_val = float(np.real(abs(raw_data[info['id']][s][idx])))\n",
    "    vth = float(np.real(raw_data[info['vth']][s][idx]))\n",
    "    vdsat = float(np.real(raw_data[info['vdsat']][s][idx]))\n",
    "    cgg = float(np.real(abs(raw_data[info['cgg']][s][idx])))\n",
    "    vgs = float(np.real(abs(raw_data[info['vgs']][s][idx])))\n",
    "    \n",
    "    ro = 1.0 / gds if gds != 0 else np.nan\n",
    "    gm_id = gm / id_val if id_val != 0 else np.nan\n",
    "    gm_ro = gm * ro\n",
    "    ft = gm / (2 * np.pi * cgg) if cgg != 0 else np.nan\n",
    "    vov = vgs - abs(vth)\n",
    "\n",
    "    tabla_op.append({\n",
    "        'Transistor': nombre,\n",
    "        'Id (uA)': round(id_val * 1e6, 2),\n",
    "        'gm (uS)': round(gm * 1e6, 2),\n",
    "        'ro (kOhm)': round(ro / 1e3, 2),\n",
    "        'gm*ro (V/V)': round(gm_ro, 2),\n",
    "        'gm/Id (1/V)': round(gm_id, 2),\n",
    "        'Vth (V)': round(vth, 3),\n",
    "        'Vov (V)': round(vov, 3),\n",
    "        'Vdsat (V)': round(vdsat, 3),\n",
    "        'fT (GHz)': round(ft / 1e9, 2)\n",
    "    })\n",
    "\n",
    "df_op = pd.DataFrame(tabla_op)\n",
    "print(f\"=== TABLA DE PUNTO DE OPERACIÓN (.OP) (Evaluado a VSG={vgs_p_sweep[idx_p]:.2f}V / VGS={vgs_n_sweep[idx_n]:.2f}V) ===\")\n",
    "df_op"
   ]
  },
  {

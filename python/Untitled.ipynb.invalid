   "source": [
    "# Caracterización Interactiva y Extracción .OP de Transistores Sky130\n",
    "---\n",
    "Este notebook permite **modificar dinámicamente los parámetros de simulación (VGS, VSG, W, L) directamente desde Python**, actualizar el netlist de SPICE, **ejecutar la simulación en NGspice**, extraer la **Tabla de Punto de Operación (.OP)** de los 4 transistores (`Mplvt`, `Mp`, `Mnlvt`, `Mn`) usando la librería preinstalada `spyci`, y visualizar las **Curvas de Caracterización Analógica Interactivas con Plotly** ($g_m/I_D$, $f_T$, $r_o$, $g_m r_o$, $V_{th}$, $V_{dsat}$) con eje X siempre en función de **$V_{GS} / V_{SG}$**, separando PMOS y NMOS."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ae46d409-d77a-472a-8ea7-2a68770da3b1",
   "metadata": {},
   "outputs": [],
   "source": [
    "print((1000*)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "72efa9b3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Netlist actualizado dinámicamente en: ../xschem/caracterizador_sim.spice\n",
      "Ejecutando simulación NGspice...\n",
      "¡Simulación completada con éxito!\n",
      "Cargando datos con spyci desde: ../xschem/caracterizador.raw...\n",
      "¡Carga exitosa! Total de puntos procesados: 32761\n"
     ]
    }
   ],
   "source": [
    "# ==============================================================================\n",
    "# Encabezado: Modificación Dinámica del Netlist, Simulación en NGspice y Carga (spyci)\n",
    "# Descripción: Permite al usuario modificar las tensiones de polarización (VSG, VGS),\n",
    "#              dimensiones de transistores (W, L) y rangos de barrido en Python.\n",
    "#              Reescribe dinámicamente los parámetros del netlist .spice, ejecuta\n",
    "#              NGspice vía subprocess y carga el archivo .raw usando spyci.\n",
    "# ==============================================================================\n",
    "\n",
    "import os\n",
    "import re\n",
    "import subprocess\n",
    "import numpy as np\n",
    "np.complex_ = complex  # Parche de compatibilidad para spyci con NumPy 2.0\n",
    "from spyci import spyci\n",
    "\n",
    "# ── 1. Parámetros Configurables desde Python ──────────────────────────────────\n",
    "VSG_TARGET = 0.6  # Tensión VSG objetivo para evaluar PMOS [V]\n",
    "VGS_TARGET = 0.6  # Tensión VGS objetivo para evaluar NMOS [V]\n",
    "\n",
    "# Dimensiones geométricas de los transistores (en micrómetros um)\n",
    "W_MPLVT = 1.0; L_MPLVT = 0.35\n",
    "W_MP    = 1.0; L_MP    = 0.15\n",
    "W_MNLVT = 1.0; L_MNLVT = 0.35\n",
    "W_MN    = 1.0; L_MN    = 0.15\n",
    "\n",
    "# Rangos de barrido DC para Vgp (PMOS) y Vgn (NMOS)\n",
    "VGP_START, VGP_STOP, VGP_STEP = 0.0, 1.8, 0.01\n",
    "VGN_START, VGN_STOP, VGN_STEP = 0.0, 1.8, 0.01\n",
    "\n",
    "# ── 2. Lectura y Modificación del Netlist SPICE ──────────────────────────────\n",
    "BASE_NETLIST = '../xschem/caracterizador.spice'\n",
    "SIM_NETLIST  = '../xschem/caracterizador_sim.spice'\n",
    "RAW_FILE     = '../xschem/caracterizador.raw'\n",
    "\n",
    "with open(BASE_NETLIST, 'r') as f:\n",
    "    spice_content = f.read()\n",
    "\n",
    "# Reemplazo dinámico de parámetros en el texto del Netlist\n",
    "spice_content = re.sub(r'\\.param vsg\\s*=\\s*[0-9.eE+-]+', f'.param vsg = {VSG_TARGET}', spice_content)\n",
    "spice_content = re.sub(r'\\.param vgs\\s*=\\s*[0-9.eE+-]+', f'.param vgs = {VGS_TARGET}', spice_content)\n",
    "\n",
    "spice_content = re.sub(r'\\.param wplvt\\s*=\\s*[0-9.eE+-]+', f'.param wplvt = {W_MPLVT}', spice_content)\n",
    "spice_content = re.sub(r'\\.param lplvt\\s*=\\s*[0-9.eE+-]+', f'.param lplvt = {L_MPLVT}', spice_content)\n",
    "\n",
    "spice_content = re.sub(r'\\.param wp\\s*=\\s*[0-9.eE+-]+', f'.param wp = {W_MP}', spice_content)\n",
    "spice_content = re.sub(r'\\.param lp\\s*=\\s*[0-9.eE+-]+', f'.param lp = {L_MP}', spice_content)\n",
    "\n",
    "spice_content = re.sub(r'\\.param wnlvt\\s*=\\s*[0-9.eE+-]+', f'.param wnlvt = {W_MNLVT}', spice_content)\n",
    "spice_content = re.sub(r'\\.param lnlvt\\s*=\\s*[0-9.eE+-]+', f'.param lnlvt = {L_MNLVT}', spice_content)\n",
    "\n",
    "spice_content = re.sub(r'\\.param wn\\s*=\\s*[0-9.eE+-]+', f'.param wn = {W_MN}', spice_content)\n",
    "spice_content = re.sub(r'\\.param ln\\s*=\\s*[0-9.eE+-]+', f'.param ln = {L_MN}', spice_content)\n",
    "\n",
    "# Actualización del comando dc en el bloque control\n",
    "spice_content = re.sub(\n",
    "    r'dc Vgp\\s+[0-9.eE+-]+\\s+[0-9.eE+-]+\\s+[0-9.eE+-]+\\s+Vgn\\s+[0-9.eE+-]+\\s+[0-9.eE+-]+\\s+[0-9.eE+-]+',\n",
    "    f'dc Vgp {VGP_START} {VGP_STOP} {VGP_STEP} Vgn {VGN_START} {VGN_STOP} {VGN_STEP}',\n",
    "    spice_content\n",
    ")\n",
    "\n",
    "with open(SIM_NETLIST, 'w') as f:\n",
    "    f.write(spice_content)\n",
    "\n",
    "print(f\"Netlist actualizado dinámicamente en: {SIM_NETLIST}\")\n",
    "\n",
    "# ── 3. Lanzar Simulación en NGspice ───────────────────────────────────────────\n",
    "print(\"Ejecutando simulación NGspice...\")\n",
    "cmd_sim = f'export PATH=/foss/tools/xschem/bin:/foss/tools/ngspice/bin:$PATH; cd ../xschem && ngspice -b caracterizador_sim.spice'\n",
    "result = subprocess.run(cmd_sim, shell=True, capture_output=True, text=True)\n",
    "\n",
    "if result.returncode == 0:\n",
    "    print(\"¡Simulación completada con éxito!\")\n",
    "else:\n",
    "    print(\"Error durante la simulación:\", result.stderr)\n",
    "\n",
    "# ── 4. Carga del archivo .raw usando spyci ────────────────────────────────────\n",
    "print(f\"Cargando datos con spyci desde: {RAW_FILE}...\")\n",
    "raw_data = spyci.load_raw(RAW_FILE)['values']\n",
    "print(f\"¡Carga exitosa! Total de puntos procesados: {len(raw_data)}\")"
   ]
  },
  {
